{
  "name": "reroute",
  "version": "2.1.0",
  "private": true,
  "description": "Charles-style request rules that run entirely in Chrome.",
  "type": "module",
  "scripts": {
    "test": "npm run check && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "check": "node scripts/check-syntax.mjs && node scripts/check-generic.mjs && prettier --check .",
    "package": "node scripts/package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "verify": "node scripts/verify.mjs",
    "lint:quiet": "eslint --quiet --format unix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.0",
    "globals": "^17.14.0",
    "playwright": "^1.50.0",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=20"
  }
}
