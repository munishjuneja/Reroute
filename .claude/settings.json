{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:e2e)",
      "Bash(npm run check)",
      "Bash(npm run package)",
      "Bash(node --test:*)",
      "Bash(node --check:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run verify)",
      "Bash(npm run verify:*)",
      "Bash(npm run lint:quiet:*)",
      "Bash(npx eslint:*)"
    ],
    "deny": [
      "Read(./private/**)",
      "Read(./package-lock.json)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./extension/icons/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/after-edit.mjs\""
          }
        ]
      }
    ]
  }
}
